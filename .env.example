# 复制本文件为 .env 并填写（.env 已被 .gitignore 忽略，不会提交到版本库）

# ============ 邮箱 IMAP ============
# IMAP 服务器与端口（SSL）。默认腾讯企业邮箱；其他邮箱服务商请改为自己的
# 判断方法：网页端邮箱「设置 → 客户端设置」里会写明 IMAP 服务器地址，不要凭域名猜。
#
# 中山大学（两套系统服务器不同，填错会 Login fail）：
#   教工 <NetID>@mail.sysu.edu.cn   （Coremail）      → IMAP_HOST=mail.sysu.edu.cn   / SMTP_HOST=mail.sysu.edu.cn
#   学生 <NetID>@mail2.sysu.edu.cn  （网易校园邮）     → IMAP_HOST=imaphz.qiye.163.com / SMTP_HOST=smtphz.qiye.163.com
#
# 其他学校：同样在网页端「客户端设置」查本单位 IMAP/SMTP 地址（详见 README 第 16 节）
IMAP_HOST=imap.exmail.qq.com
IMAP_PORT=993
# 完整邮箱地址（含 @ 域名）
IMAP_USER=yourname@company.com
# 16 位授权码（不是登录密码！）：
#   网页端邮箱 → 设置 → 客户端设置 → 生成/获取授权码（可能含 # 等符号，属正常）
# 授权码可随时重置作废；一旦泄露请立即重置
IMAP_AUTH_CODE=

# ============ SMTP（推送邮件给自己时需要）============
# 发信服务器与端口（SSL），账号授权码与 IMAP 同一个
SMTP_HOST=mail.sysu.edu.cn
SMTP_PORT=465

# ============ NASA ADS API ============
# 在 https://ui.adsabs.harvard.edu/user/settings/token 免费申请，不过期
# 官方限额：3000 次/天，15 次/秒
# 留空则运行离线模式（只提取 bibcode，不查摘要）
ADS_API_TOKEN=

# ============ LLM（公共默认；分 Agent 请用下面的独立 key）============
# 在 https://platform.deepseek.com 申请 API key（按量计费，很便宜）
# 公共 key 会同时用于两个 Agent；只想给某个 Agent 用云模型时，
# 设独立 key 且不填公共 key（这样另一个 Agent 的附件/数据不会发往云端）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ============ Agent 域开关（分 Agent 使用）============
# ADS 文献 Agent / 项目申报 Agent，false 关闭对应功能
ADS_ENABLED=true
GRANTS_ENABLED=true
# 各 Agent 独立 LLM key（缺省回退 DEEPSEEK_API_KEY）
ADS_LLM_API_KEY=
GRANTS_LLM_API_KEY=

# ===== 基金邮件可信发件人（安全必需：防恶意附件）=====
# 攻击者可能发送主题含「申报通知」的邮件投递恶意压缩包。
# 只对白名单内发件人的邮件做附件解压。支持逗号分隔：完整地址 / *@域名 / 裸域名。
# 留空 = 拒绝处理所有基金邮件附件（fail-closed）。
GRANT_ALLOWED_SENDERS=

# 严格发件人认证（可选）：true 时要求 Authentication-Results 有 pass 且与 From 域对齐，
# 缺失/neutral 一律拒绝（默认 false，兼容校内互发无认证头）
GRANTS_STRICT_AUTH=false

# 可信认证服务器（authserv-id）白名单，逗号分隔；非空时只采信这些服务器写入的
# Authentication-Results（防伪造认证头）。例：GRANTS_AUTH_SERVERS=mail.sysu.edu.cn,imaphz.qiye.163.com
GRANTS_AUTH_SERVERS=

# ============ 通用（可选）============
# 数据目录：默认项目内 data/（含邮件缓存、简报、状态文件）；服务器部署建议指到独立目录
# MAIL_DIGEST_DATA_DIR=~/mail-digest-data
# 时区：程序内部口径（日志、简报文件名、截止点计算）；默认 Asia/Shanghai
# 注意：它不改变 cron 何时触发——cron 用的是系统时区，见 README 第 15 节
MAIL_DIGEST_TIMEZONE=Asia/Shanghai
# 计划推送时刻（默认 09:00）：正式推送只发送该时刻之前到达的邮件，
# 之后到达的留到下一次，因此 cron 晚几分钟启动也不会把新邮件提前发出去
MAIL_DIGEST_PUSH_TIME=09:00
# 首次接管邮箱时的单轮全量拉取上限（默认 5000）；超出会分批继续补拉，不会丢弃
# MAIL_DIGEST_FETCH_INITIAL_MAX=5000
