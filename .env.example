# 复制本文件为 .env 并填写（.env 已被 .gitignore 忽略，不会提交到版本库）

# ============ 邮箱 IMAP ============
# IMAP 服务器与端口（SSL）。默认腾讯企业邮箱；其他邮箱服务商请改为自己的
#   例：网易企业邮箱 imaphz.qiye.163.com、Coremail 学校邮箱见本单位帮助文档
#   判断方法：网页端邮箱「设置 → 客户端设置」里会写明 IMAP 服务器地址
IMAP_HOST=imap.exmail.qq.com
IMAP_PORT=993
# 完整邮箱地址
IMAP_USER=yourname@company.com
# 16 位授权码（不是登录密码）：
#   网页端邮箱 → 设置 → 客户端设置 → 【获取授权密码】
# 授权码可随时重置作废；一旦泄露请立即重置
IMAP_AUTH_CODE=

# ============ NASA ADS API ============
# 在 https://ui.adsabs.harvard.edu/user/settings/token 免费申请，不过期
# 官方限额：3000 次/天，15 次/秒
# 留空则运行离线模式（只提取 bibcode，不查摘要）
ADS_API_TOKEN=

# ============ DeepSeek（M3：中文翻译/一句话点评/相关性分级）============
# 在 https://platform.deepseek.com 申请 API key（按量计费，很便宜）
# 留空则跳过 LLM，只输出英文简报
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ===== 基金邮件可信发件人（安全必需：防恶意附件）=====
# 攻击者可能发送主题含「申报通知」的邮件投递恶意压缩包。
# 只对白名单内发件人的邮件做附件解压。支持逗号分隔：完整地址 / *@域名 / 裸域名。
# 留空 = 拒绝处理所有基金邮件附件（fail-closed）。
GRANT_ALLOWED_SENDERS=
